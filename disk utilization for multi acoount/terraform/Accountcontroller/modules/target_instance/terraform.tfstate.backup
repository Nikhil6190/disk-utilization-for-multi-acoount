            "content": "{\"description\":\"Automated Disk Cleanup\",\"mainSteps\":[{\"action\":\"aws:runShellScript\",\"inputs\":{\"runCommand\":[\"echo 'Starting disk cleanup...'\",\"sudo rm -rf /tmp/*\",\"sudo rm -rf /var/tmp/*\",\"sudo journalctl --vacuum-time=7d\",\"echo 'Disk cleanup completed.'\"]},\"name\":\"cleanupDiskSpace\"}],\"schemaVersion\":\"2.2\"}",
